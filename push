#!/bin/bash

set -e  # Exit on any error

BASE_DIR="/srv/projects/grande_royal/new_app"
ADMIN_DIR="$BASE_DIR/admin"
BUILD_DIR="$BASE_DIR/admin_build"

echo "🚀 Starting deployment..."

# Clean build directory (preserve .git)
cd "$BUILD_DIR"
echo "🧹 Cleaning build directory..."
find . -maxdepth 1 ! -name '.git' ! -name '.' -exec rm -rf {} + 2>/dev/null || true

# Build the project
cd "$ADMIN_DIR"
echo "📦 Building project..."
npm run build

# Copy build files
echo "📋 Copying build files..."
cp -r "$ADMIN_DIR/build/." "$BUILD_DIR/"

# Remove shared directory if it exists
if [ -d "$BUILD_DIR/shared" ]; then
    echo "🗑️ Removing shared directory..."
    rm -rf "$BUILD_DIR/shared"
fi

# Git operations
cd "$BUILD_DIR"
echo "📝 Committing changes..."
git add .
read -p "💬 Commit message: " message
git commit -m "$message"
git push

echo "✅ Deployment completed successfully!"
